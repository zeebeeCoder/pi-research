{
  "name": "pi-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.3.0" },
  "files": ["extensions/", "src/", "skills/", "profiles/", "docs/", "patches/", "tests/", "README.md"],
  "description": "Bounded research with search providers, Yahoo market evidence, indicators and charts",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/research.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "bun test ./tests/*.test.ts && node --test tests/native/*.test.mjs tests/market/*.test.mjs",
    "test:market": "node --test tests/market/*.test.mjs",
    "test:market-contact": "node tests/live/market-contact.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
